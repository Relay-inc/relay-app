# Copy to .env next to compose.yml and change what you need. Every line is optional.

# The name Relay shows for this machine.
RELAY_HOST=relay-server

# The port on this box. Open it to the Macs that use the server (docs/relay-server.md).
RELAY_PORT=47800

# How much RAM the mirror's working copy may take. Only used when a paired laptop mirrors its vault here.
RELAY_WORK_SIZE=2g

# Another image or tag than the one in compose.yml, for example one you built yourself.
# RELAY_SERVER_IMAGE=ghcr.io/relay-inc/relay-server:0.0.49
