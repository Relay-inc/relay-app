{
  "name": "relay",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test --experimental-strip-types \"packages/*/tests/*.test.ts\" \"src/**/*.test.ts\"",
    "lint": "lit-analyzer src && eslint src",
    "format": "prettier --write src index.html settings.html",
    "format:check": "prettier --check src index.html settings.html"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@relay/agent-claude": "workspace:*",
    "@relay/agent-codex": "workspace:*",
    "@relay/agent-core": "workspace:*",
    "@relay/agent-opencode": "workspace:*",
    "@relay/agent-pi": "workspace:*",
    "@relay/board-core": "workspace:*",
    "@relay/integration-linear": "workspace:*",
    "@relay/integration-productive": "workspace:*",
    "@relay/integration-trello": "workspace:*",
    "@tauri-apps/api": "^2",
    "lit": "^3.3.3",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "globals": "^17.13.0",
    "lit-analyzer": "^2.0.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "ts-lit-plugin": "^2.0.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.16"
  }
}
