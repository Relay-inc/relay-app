    "@relay/agent-core": "workspace:*",
    "@relay/agent-opencode": "workspace:*",
    "@relay/agent-pi": "workspace:*",
    "@relay/board-core": "workspace:*",
    "@relay/integration-linear": "workspace:*",
    "@relay/integration-productive": "workspace:*",
    "@relay/integration-trello": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "immer": "^11.1.18",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
