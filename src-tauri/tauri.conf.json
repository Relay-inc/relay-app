{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "../package.json",
  "identifier": "be.laurentmeersman.relay",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Relay",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; frame-src relay-plugin:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/default-vault/": "default-vault/",
      "resources/team-vault/": "team-vault/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "relay"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2QjVGQzUxMTk1NUIzMjgKUldRb3MxVVpVZnkxWmdYc29SVkthUFZJS20rVGpmZVpGdDErcVFnbHVYSzhqTVJoZzJuWUxKNGcK",
      "endpoints": [
        "https://api.github.com/repos/Relay-inc/relay-app/contents/latest.json?ref=updates"
      ]
    }
  }
}
