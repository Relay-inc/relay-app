{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "../../package.json",
  "identifier": "be.laurentmeersman.relay.mobile",
  "build": {
    "beforeBuildCommand": "cd .. && pnpm exec vite build --config mobile/vite.config.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Relay",
        "width": 420,
        "height": 820,
        "url": "mobile.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
