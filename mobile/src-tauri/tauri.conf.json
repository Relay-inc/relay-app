{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "../../package.json",
  "identifier": "be.laurentmeersman.relay.mobile",
  "build": { "frontendDist": "../www" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Relay", "width": 420, "height": 820 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
